# Local MVP defaults. Copy to .env and override as needed.
APP_NAME=Koubo Studio
DATA_DIR=data

# Provider selection: auto tries API when configured, then local/fallback.
# UI can override each job with auto|local|api.
DEFAULT_ASR_PROVIDER=auto
DEFAULT_LLM_PROVIDER=auto
DEFAULT_TTS_PROVIDER=auto
DEFAULT_LIPSYNC_PROVIDER=auto
DEFAULT_TTS_MODEL=f5

# Optional model command templates.
# Commands receive file paths and should write their result to the output path.
# Use these when running open-source projects in separate virtualenvs/containers.
#
# ASR_COMMAND=python scripts/adapters/whisper_asr.py --input {audio} --output {text}
# LLM_COMMAND=python scripts/adapters/ollama_rewrite.py --input {input} --output {output}
# TTS_COMMAND=python your_tts_wrapper.py --input {input} --voice {voice} --voice-sample {voice_sample} --output {audio}
# F5_TTS_COMMAND=python scripts/adapters/f5_tts.py --input {input} --voice {voice} --voice-sample {voice_sample} --output {audio}
# INDEXTTS_COMMAND=models/IndexTTS/.venv/Scripts/python.exe scripts/adapters/indextts2_tts.py --input {input} --voice-sample {voice_sample} --output {audio}
# LIPSYNC_COMMAND=python scripts/adapters/lipsync_command.py --video {video} --audio {audio} --output {output}
# LATENTSYNC_COMMAND=python scripts/adapters/latentsync_lipsync.py --video {video} --audio {audio} --output {output}

ASR_COMMAND=
LLM_COMMAND=
TTS_COMMAND=
F5_TTS_COMMAND=
INDEXTTS_COMMAND=
LIPSYNC_COMMAND=
LATENTSYNC_COMMAND=

# IndexTTS2 local model paths. Run scripts/setup_local_models.ps1 -WithIndexTTS first.
INDEXTTS_DIR=models/IndexTTS
INDEXTTS_MODEL_DIR=models/IndexTTS/checkpoints
INDEXTTS_CFG=models/IndexTTS/checkpoints/config.yaml
INDEXTTS_FP16=true
INDEXTTS_CUDA_KERNEL=false
INDEXTTS_DEEPSPEED=false

# MuseTalk tuning. Higher batch size is faster if VRAM allows; bbox shift changes mouth region placement.
MUSETALK_BATCH_SIZE=8
MUSETALK_BBOX_SHIFT=0

# LatentSync high-quality mode. LatentSync 1.5 is more suitable for 12GB GPUs than 1.6.
LATENTSYNC_DIR=models/LatentSync
LATENTSYNC_PYTHON=.venv-latentsync/Scripts/python.exe
LATENTSYNC_CONFIG=configs/unet/stage2.yaml
LATENTSYNC_CHECKPOINT=checkpoints/latentsync_unet.pt
LATENTSYNC_STEPS=20
LATENTSYNC_GUIDANCE_SCALE=1.5
LATENTSYNC_DEEPCACHE=true

# Optional yt-dlp settings for platforms that require browser cookies.
# For Douyin, export douyin.com cookies as a Netscape cookies.txt file and set:
# YTDLP_COOKIES_FILE=D:/path/to/douyin-cookies.txt
# Browser auto-read may work on some machines, for example chrome or edge:
# YTDLP_COOKIES_FROM_BROWSER=chrome
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_PROXY=

# Optional Ollama fallback for script rewriting.
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BIN=
AUTO_UNLOAD_OLLAMA_BEFORE_MEDIA=true

# Optional API providers.
# ASR_API_URL can be OpenAI-compatible /audio/transcriptions or any multipart endpoint returning {"text": "..."}.
ASR_API_URL=
ASR_API_KEY=
ASR_API_MODEL=whisper-1
ASR_API_FILE_FIELD=file

# LLM_API_URL should be OpenAI-compatible /chat/completions.
LLM_API_URL=
LLM_API_KEY=
LLM_API_MODEL=gpt-4o-mini
LLM_API_TEMPERATURE=0.7

# TTS_API_URL supports JSON endpoints that return audio bytes, or multipart endpoints when TTS_API_MODE=multipart.
# JSON payload fields default to OpenAI-compatible: model/input/voice.
# Multipart can include uploaded voice samples with field TTS_API_FILE_FIELD.
TTS_API_URL=
TTS_API_KEY=
TTS_API_MODEL=tts-1
TTS_API_VOICE=alloy
TTS_API_MODE=json
TTS_API_TEXT_FIELD=input
TTS_API_VOICE_FIELD=voice
TTS_API_FILE_FIELD=voice_sample

# Lip-sync API accepts video+audio multipart and returns video bytes, video_url, or video_base64.
LIPSYNC_API_URL=
LIPSYNC_API_KEY=
LIPSYNC_API_VIDEO_FIELD=video
LIPSYNC_API_AUDIO_FIELD=audio

# If true, try to burn subtitles with ffmpeg after lipsync.
BURN_SUBTITLES=false

# Publication is intentionally stubbed in the MVP.
ENABLE_BROWSER_PUBLISH=false
